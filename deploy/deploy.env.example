# ============================================================================
# Tawfeer Online — deployment parameters (Ubuntu 24.04)
# Copy to `deploy/deploy.env` on the SERVER and fill in. NEVER commit deploy.env.
# All deploy/*.sh scripts source this file.
# ============================================================================

# --- Domain / TLS -----------------------------------------------------------
DOMAIN="example.com"                 # primary domain (DNS A-record -> this VPS)
DOMAIN_ALIASES="www.example.com"     # space-separated extra server_names ("" if none)
LETSENCRYPT_EMAIL="admin@example.com" # for certbot expiry notices

# --- App location / account -------------------------------------------------
DEPLOY_USER="deployer"               # non-root, sudo-capable user that OWNS the code + runs php-fpm/workers
APP_PATH="/var/www/tawfeer"          # deploy root (the Laravel project directory)
REPO_URL="https://github.com/omardes2/tawfeer-online-system.git"
REPO_BRANCH="main"                   # branch to deploy (change to your release branch)

# --- PHP --------------------------------------------------------------------
PHP_VERSION="8.3"

# --- Database (MariaDB) -----------------------------------------------------
DB_NAME="tawfeer"
DB_USER="tawfeer"
DB_PASSWORD="CHANGE_ME_strong_db_password"
DB_ROOT_PASSWORD="CHANGE_ME_strong_root_password"   # set for fresh MariaDB; used by provision.sh

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD="CHANGE_ME_strong_redis_password"    # "" to leave Redis without auth (not recommended)

# --- Queue workers ----------------------------------------------------------
WORKER_PROCS="2"                     # number of queue:work processes under Supervisor

# --- Node -------------------------------------------------------------------
NODE_MAJOR="22"                      # Node.js LTS major version
