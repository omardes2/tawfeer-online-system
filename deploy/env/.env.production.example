# ============================================================================
# Tawfeer Online — PRODUCTION .env template.
# deploy.sh copies this to <APP_PATH>/.env and fills DB/Redis/URL from deploy.env.
# Fill the remaining secrets by hand. NEVER commit the real .env.
# ============================================================================
APP_NAME="Tawfeer Online"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging — daily rotation, warnings+ in production
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MariaDB / MySQL) --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tawfeer
DB_USERNAME=tawfeer
DB_PASSWORD=

# --- Session / Cache / Queue (Redis) ---------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (set to your SMTP provider) --------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Integrations (fill from each provider; stay in .env only) --------------
# OpenAI (AI product content)
OPENAI_API_KEY=
# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
# Payment / messaging drivers
# PAYMENT_DRIVER=
# MESSAGING_WHATSAPP_TOKEN=
# MESSAGING_MESSENGER_TOKEN=
# MESSAGING_INSTAGRAM_TOKEN=

# --- Delivery / marketing scheduled jobs (toggle as needed) -----------------
DELIVERY_SYNC_ENABLED=false
DELIVERY_ESCALATION_ENABLED=false

# شركة التوصيل Opost (طبقة التكامل) — الأسرار على الخادم فقط ولا تُرفع للـGit
# لتفعيل الإرسال الحيّ للشحنات عند تأكيد الطلب: SHIPPING_PROVIDER=opost
SHIPPING_PROVIDER=null
OPOST_BASE_URL=https://opost.ps/api
# OAuth2 (Password Grant): النظام يسجّل الدخول ويجدّد التوكن آليًا — لا حاجة لتوكن ثابت
OPOST_OAUTH_URL=https://opost.ps/oauth/token
OPOST_CLIENT_ID=
OPOST_CLIENT_SECRET=
OPOST_USERNAME=
OPOST_PASSWORD=
OPOST_SCOPE=
# توكن ثابت اختياري (يُستخدم فقط إن لم تُضبط بيانات OAuth أعلاه)
OPOST_API_TOKEN=
OPOST_BUSINESS_ID=
OPOST_BUSINESS_ADDRESS_ID=
OPOST_SHIPMENT_TYPE_ID=1
