# ============================================================================
# Tawfeer Online — Production environment template (NO SECRETS).
# Copy to .env on the server and fill real values there. NEVER commit .env.
# All secrets live ONLY in this server-side .env (git-ignored).
# ============================================================================

APP_NAME="Tawfeer Online"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --force
APP_DEBUG=false               # MUST be false in production
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging (rotate daily, keep 14 days; warning+ in prod) ------------------
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL 8 / MariaDB 10.6+) -------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tawfeer_prod
DB_USERNAME=tawfeer
DB_PASSWORD=                  # strong password; cPanel MySQL user

# --- Redis (cache + sessions + queue + rate limiting) -----------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=              # set a password on the Redis instance
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis        # queued marketing sends run on the worker
DB_QUEUE_RETRY_AFTER=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (SMTP) ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Social login (Phase 3.5) — fill from each provider console -------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# --- Delivery provider (Opost) + webhook + sync (Phase 4.3 / ADR-039) -------
# Leave DELIVERY_* disabled until the real Opost account/secret is configured.
DELIVERY_SYNC_ENABLED=false            # true to enable scheduled status sync
DELIVERY_ESCALATION_ENABLED=false      # true to enable overdue-exception escalation
OPOST_API_KEY=
OPOST_BASE_URL=https://api.opost.ps
OPOST_WEBHOOK_SECRET=                  # HMAC secret; webhook rejected without it

# --- AI product content (Phase 6 / ADR-044) — env-only credentials ----------
# Default provider is the safe offline "null" driver. Set to "openai" only
# after OPENAI_API_KEY is present. Generated content is ALWAYS a suggestion.
AI_PROVIDER=null                       # null | openai
OPENAI_API_KEY=                        # required only when AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=20
AI_MAX_RETRIES=2
AI_RATE_LIMIT=20                       # requests/user/minute
AI_VISION=false                        # send selected product image (with authz)

# --- Messaging providers (Phase 6 / ADR-046) — WhatsApp / Email / SMS -------
# Each channel maps to a driver in config/messaging.php. Default "null" = no
# external send. Register a real driver + its secret before switching.
MESSAGING_DRIVER=null
MESSAGING_WHATSAPP=null                # e.g. whatsapp_cloud (when implemented)
MESSAGING_EMAIL=null                   # e.g. ses
MESSAGING_SMS=null
MESSAGING_MARKETING=null

# --- Storefront -------------------------------------------------------------
STOREFRONT_RECOMMENDATION_PROVIDER=rule   # rule (default) | null
STOREFRONT_FREE_SHIPPING_THRESHOLD=

# --- Ad platform (ADR-052) — daily ad-spend sync (READ ONLY) ----------------
# Default "null" = nothing is fetched and manual entry keeps working. Switch to
# "meta" only after linking campaigns/ad sets under Settings → ربط الحملات.
# The token is a Business *System User* token (they do not expire on logout)
# with ads_read only — it cannot create, pause, or fund anything.
ADS_DRIVER=null                        # null | meta
META_ADS_TOKEN=                        # System User token, ads_read scope
META_ADS_ACCOUNT_ID=                   # the digits after act= in the Ads Manager URL
META_ADS_API_VERSION=v21.0
META_ADS_CONVERSATION_ACTION=onsite_conversion.messaging_conversation_started_7d
META_ADS_TIMEOUT=30
ADS_SYNC_ENABLED=false                 # nightly schedule; leave false until linked
ADS_SYNC_CRON=30 4 * * *
ADS_SYNC_LOOKBACK_DAYS=3               # Meta revises figures for 24-72h
