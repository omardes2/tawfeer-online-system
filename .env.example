APP_NAME="Tawfeer Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# قاعدة البيانات — MySQL (الإنتاج والتطوير الافتراضي)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tawfeer
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@tawfeer.online"
MAIL_FROM_NAME="${APP_NAME}"

# طبقة التكامل (تُملأ عند تنفيذ الوحدات — لا تضع أسرارًا حقيقية في المستودع)
# PAYMENT_DRIVER=null
# MESSAGING_WHATSAPP_TOKEN=
# MESSAGING_MESSENGER_TOKEN=
# MESSAGING_INSTAGRAM_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# تسجيل الدخول الاجتماعي (Phase 3.5) — تُملأ من لوحة كل مزوّد، وتبقى في .env فقط
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# شركة التوصيل Opost (طبقة التكامل) — التوكن سرّ، يُوضع على الخادم فقط ولا يُرفع للـGit
# لتفعيل الإرسال الحيّ عند تأكيد الطلب اضبط SHIPPING_PROVIDER=opost
SHIPPING_PROVIDER=null
OPOST_BASE_URL=https://opost.ps/api
OPOST_API_TOKEN=
OPOST_BUSINESS_ID=
OPOST_BUSINESS_ADDRESS_ID=
OPOST_SHIPMENT_TYPE_ID=1
