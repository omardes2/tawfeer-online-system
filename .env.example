APP_NAME="Tawfeer Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# قاعدة البيانات — MySQL (الإنتاج والتطوير الافتراضي)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tawfeer
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# عمر الجلسة بالدقائق — ٤٨٠ = يوم عمل كامل، فلا تنتهي جلسة الموظف أثناء دوامه.
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@tawfeer.online"
MAIL_FROM_NAME="${APP_NAME}"

# طبقة التكامل (تُملأ عند تنفيذ الوحدات — لا تضع أسرارًا حقيقية في المستودع)
# PAYMENT_DRIVER=null
# MESSAGING_WHATSAPP_TOKEN=
# MESSAGING_MESSENGER_TOKEN=
# MESSAGING_INSTAGRAM_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# تسجيل الدخول الاجتماعي (Phase 3.5) — تُملأ من لوحة كل مزوّد، وتبقى في .env فقط
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# شركة التوصيل Opost (طبقة التكامل) — الأسرار على الخادم فقط ولا تُرفع للـGit
# لتفعيل الإرسال الحيّ عند تأكيد الطلب اضبط SHIPPING_PROVIDER=opost
SHIPPING_PROVIDER=null
OPOST_BASE_URL=https://opost.ps/api
# OAuth2 (Password Grant): النظام يسجّل الدخول ويجدّد التوكن آليًا — لا حاجة لتوكن ثابت
OPOST_OAUTH_URL=https://opost.ps/oauth/token
OPOST_CLIENT_ID=
OPOST_CLIENT_SECRET=
OPOST_USERNAME=
OPOST_PASSWORD=
OPOST_SCOPE=
# توكن ثابت اختياري (يُستخدم فقط إن لم تُضبط بيانات OAuth أعلاه)
OPOST_API_TOKEN=
OPOST_BUSINESS_ID=
OPOST_BUSINESS_ADDRESS_ID=
OPOST_SHIPMENT_TYPE_ID=1

# بكسل ميتا (فيسبوك/إنستغرام) — قياس المبيعات في مدير الإعلانات.
# المتصفّح (PageView + ViewContent) يعمل بمجرّد ضبط المعرّف وحده:
META_PIXEL_ID=
# حدث الشراء يُرسَل من الخادم (Conversions API) لا من المتصفّح — مسار الإتمام
# محميّ، ومانعات الإعلانات تُسقط أحداث المتصفّح. لتشغيله اضبط المحرّك والتوكن:
ADS_PIXEL_DRIVER=null
# ADS_PIXEL_DRIVER=meta
META_PIXEL_TOKEN=
# رمزُ اختبارٍ يُملأ أثناء الضبط ليظهر الحدث في «اختبار الأحداث»، ثم يُفرَّغ.
META_PIXEL_TEST_EVENT_CODE=
# افتراضيّة صحيحة لفلسطين — تُغيَّر عند الحاجة فقط.
META_PIXEL_CURRENCY=ILS
META_PIXEL_COUNTRY_CODE=970

# مزامنة حالات التوصيل (مطلوبة لتحديث حالة الطرد تلقائيًا من شركة التوصيل).
# بدون DELIVERY_SYNC_ENABLED=true تبقى حالة الطرد في النظام كما أُنشئت ولا تتغيّر أبدًا.
DELIVERY_SYNC_ENABLED=true
DELIVERY_SYNC_CRON="* * * * *"
DELIVERY_ESCALATION_ENABLED=true
# سرّ توقيع الـwebhook (اختياري — للتحديث الفوري بدل انتظار المزامنة).
OPOST_WEBHOOK_SECRET=

# ── وكيل المبيعات الذكي (واتساب) — راجع docs/AI_SALES_AGENT.md ──
# مُطفأ افتراضيًّا: تشغيل ذكاءٍ يحادث الزبائن باسم الشركة قرارٌ إداريّ صريح.
# والإطفاء يوقف الردّ وحده — الاستقبال والتخزين والعرض تبقى عاملة.
AI_AGENT_ENABLED=false
AI_AGENT_MODEL=claude-sonnet-5
AI_AGENT_MAX_TOKENS=1024
AI_AGENT_DEBOUNCE_SECONDS=5
AI_AGENT_MAX_WAIT_SECONDS=20
AI_AGENT_MAX_TOOL_CALLS=6
AI_AGENT_HISTORY_MESSAGES=20
ANTHROPIC_API_KEY=
